# Server Configuration
TIMEOUT=600
CHUNK_TOKEN_SIZE=512
CHUNK_OVERLAP_TOKEN_SIZE=50
EMBEDDING_BATCH_NUM=16
EMBEDDING_FUNC_MAX_ASYNC=8
LLM_MODEL_MAX_TOKEN_SIZE=2048
LLM_MODEL_MAX_ASYNC=2



# Use OpenRouter as the LLM binding
LLM_BINDING=openai
LLM_MODEL=deepseek/deepseek-r1-0528:free
LLM_BINDING_HOST=https://openrouter.ai/api/v1
LLM_BINDING_API_KEY=your key here
TEMPERATURE=0.5
ENABLE_LLM_CACHE=false
ENABLE_LLM_CACHE_FOR_ENTITY_EXTRACT=false


# Embedding Settings
EMBEDDING_BINDING=ollama
EMBEDDING_MODEL=all-minilm:latest
EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
EMBEDDING_BINDING_API_KEY=        # (leave blank; Ollama does not require an API key)
EMBEDDING_DIM=384
EMBEDDING_BATCH_NUM=16
EMBEDDING_FUNC_MAX_ASYNC=4


### Data storage selection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD='postgres'
POSTGRES_DATABASE=postgres
POSTGRES_MAX_CONNECTIONS=12

### Neo4j Configuration
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD='lightrag'

### MongoDB Configuration
MONGO_URI=mongodb://root:root@mongodb:27017/
MONGO_DATABASE=LightRAG

### Summary Configuration
SUMMARY_LANGUAGE=English 